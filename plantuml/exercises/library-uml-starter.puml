@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + getLoanPeriod() : int
}

class Book {
  + Book(title : String, catalogueNumber : String)
  + getLoanPeriod() : int
}

class DVD {
  + DVD(title : String, catalogueNumber : String)
  + getLoanPeriod() : int
}

class ReferenceOnlyItem {
  + ReferenceOnlyItem(title : String, catalogueNumber : String)
}

class LibraryPerson {
  # {static} catalogue : List<Item>
  # {static} loanedItems : List<Item>
  # {static} holds : List<Hold>
}

class Member {
  - memberNumber : int
  + logIn() : void
  + borrow(item : Borrowable) : void
  + placeHold(item : Borrowable) : void
}

class Librarian {
  + addToCatalogue(item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Hold {
  - member : Member
  - item : Item
  + Hold(member : Member, item : Item)
  + getMember() : Member
  + getItem() : Item
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceOnlyItem
Borrowable <|.. Book
Borrowable <|.. DVD
LibraryPerson <|-- Member
LibraryPerson <|-- Librarian

@enduml
